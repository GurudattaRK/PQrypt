<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal"
        android:background="?android:attr/colorBackground">

        <!-- App Logo -->
        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="PQrypt Logo"
            android:src="@drawable/logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:text="PQrypt"
            android:textAppearance="@style/TextAppearance.PQrypt.Headline" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_secure_share"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Secure Share"
                android:textSize="13sp"
                android:textAppearance="@style/TextAppearance.PQrypt.Button"
                android:textColor="?attr/colorOnPrimary"
                app:backgroundTint="?attr/colorPrimary"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_secure_share"
                app:iconTint="@null"
                app:iconGravity="textTop"
                app:iconPadding="6dp"
                app:iconSize="60dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_file_encryption"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="File Encryption"
                android:textSize="13sp"
                android:textAppearance="@style/TextAppearance.PQrypt.Button"
                android:textColor="?attr/colorOnPrimary"
                app:backgroundTint="?attr/colorPrimary"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_file_encryption"
                app:iconTint="@null"
                app:iconGravity="textTop"
                app:iconPadding="6dp"
                app:iconSize="60dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_pqc_key_exchange"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="PQC Key Exchange"
                android:textSize="13sp"
                android:textAppearance="@style/TextAppearance.PQrypt.Button"
                android:textColor="?attr/colorOnPrimary"
                app:backgroundTint="?attr/colorPrimary"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_pqc_key_exchange"
                app:iconTint="@null"
                app:iconGravity="textTop"
                app:iconPadding="6dp"
                app:iconSize="60dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_password_vault"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Password Generator"
                android:textSize="13sp"
                android:textAppearance="@style/TextAppearance.PQrypt.Button"
                android:textColor="?attr/colorOnPrimary"
                app:backgroundTint="?attr/colorPrimary"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_password_generator"
                app:iconTint="@null"
                app:iconGravity="textTop"
                app:iconPadding="6dp"
                app:iconSize="60dp" />

        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_help"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Help"
            app:icon="@drawable/ic_help"
            app:iconGravity="textStart" />

    </LinearLayout>

</ScrollView>