<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".SecureShareModeActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:text="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="20dp"
            android:text="Secure Share"
            android:textAppearance="@style/TextAppearance.PQrypt.Title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="What do you want to share?"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/tg_content_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:checkedButton="@id/rb_text"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rb_text"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:checkable="true"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Text"
                android:textAppearance="@style/TextAppearance.PQrypt.Button"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_text"
                app:iconTint="@null"
                app:iconGravity="textTop"
                app:iconPadding="6dp"
                app:iconSize="52dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rb_file"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:checkable="true"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="File"
                android:textAppearance="@style/TextAppearance.PQrypt.Button"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_file"
                app:iconTint="@null"
                app:iconGravity="textTop"
                app:iconPadding="6dp"
                app:iconSize="52dp" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="How do you want to transfer?"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/tg_transfer_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:checkedButton="@id/rb_manual"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rb_manual"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:checkable="true"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Manual"
                android:textAppearance="@style/TextAppearance.PQrypt.Button"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_manual"
                app:iconTint="@null"
                app:iconGravity="textTop"
                app:iconPadding="6dp"
                app:iconSize="52dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rb_bluetooth"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:checkable="true"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Bluetooth"
                android:textAppearance="@style/TextAppearance.PQrypt.Button"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_bluetooth"
                app:iconTint="@null"
                app:iconGravity="textTop"
                app:iconPadding="6dp"
                app:iconSize="52dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rb_wifi_direct"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:checkable="true"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Wi‑Fi"
                android:textAppearance="@style/TextAppearance.PQrypt.Button"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_wifi_direct"
                app:iconTint="@null"
                app:iconGravity="textTop"
                app:iconPadding="6dp"
                app:iconSize="52dp" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_send"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Send"
                android:textAppearance="@style/TextAppearance.PQrypt.Button"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_send"
                app:iconTint="@null"
                app:iconGravity="textTop"
                app:iconPadding="6dp"
                app:iconSize="52dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_receive"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Receive"
                android:textAppearance="@style/TextAppearance.PQrypt.Button"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_receive"
                app:iconTint="@null"
                app:iconGravity="textTop"
                app:iconPadding="6dp"
                app:iconSize="52dp" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_help"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Help"
            app:icon="@drawable/ic_help"
            app:iconGravity="textStart" />

    </LinearLayout>

</ScrollView>
