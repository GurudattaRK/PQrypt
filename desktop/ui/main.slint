                    }

                    Text {
                        text: "Key file: " + key-file-path;
                        wrap: word-wrap;
                    }

                    VerticalBox {
                        spacing: 12px;
                        alignment: center;

                        property <length> grid_w: 360px;
                        property <length> tile: Math.min(160px, (grid_w - 12px) / 2);

                        HorizontalBox {
                            Rectangle { }
                            HorizontalBox {
                                spacing: 12px;
                                width: grid_w;

                                TileButton {
                                    text: "Encrypt";
                                    icon: @image-url("SVG/encrypt.svg");
                                    bg: AppPalette.green;
                                    radius: 28px;
                                    icon-size: 56px;
                                    text-size: 12px;
                                    width: tile;
                                    height: tile;
                                    clicked => { encrypt-file(); }
                                }

                                TileButton {
                                    text: "Decrypt";
