import { Button, VerticalBox, HorizontalBox, LineEdit, CheckBox, Slider, ScrollView, Palette } from "std-widgets.slint";

export global AppPalette {
    in-out property <brush> red: #B3261E;
    in-out property <brush> green: #2E7D32;
    in-out property <brush> blue: #6750A4;
    in-out property <brush> light_purple: #7E57C2;
    in-out property <brush> light_orange: #FF8F00;
    in-out property <brush> white: #ffffff;
}

component ColorButton inherits Rectangle {
    in-out property <string> text: "";
    in-out property <brush> bg: AppPalette.blue;
    in-out property <brush> fg: #000000;
    in-out property <length> radius: 28px;
    callback clicked();

    background: bg;
    border-radius: radius;
    clip: true;
    height: 44px;
    min-width: 80px;
    vertical-stretch: 0;

    TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        text: root.text;
        color: root.fg;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-weight: 600;
        font-family: "Inter";
        font-size: 14px;
    }
}

component IconButtonRight inherits Rectangle {
    in-out property <string> text: "";
    in property <image> icon;
    in-out property <brush> bg: AppPalette.blue;
    in-out property <brush> fg: #000000;
    in-out property <length> radius: 28px;
    in-out property <length> icon-size: 20px;
    callback clicked();

    background: bg;
    border-radius: radius;
    clip: true;
    height: 44px;
    min-width: 80px;
    vertical-stretch: 0;

    TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalBox {
        height: parent.height;
        spacing: 8px;
        alignment: center;

        Text {
            text: root.text;
            color: root.fg;
            vertical-alignment: center;
            wrap: no-wrap;
            overflow: elide;
            font-weight: 600;
            font-family: "Inter";
            font-size: 14px;
        }

        Image {
            source: root.icon;
            width: root.icon-size;
            height: root.icon-size;
            horizontal-alignment: center;
            vertical-alignment: center;
            image-fit: contain;
        }
    }
}

component TileButton inherits Rectangle {
    in-out property <string> text: "";
    in property <image> icon;
    in-out property <brush> bg: AppPalette.blue;
    in-out property <brush> fg: #000000;
    in-out property <length> radius: 28px;
    in-out property <length> icon-size: 72px;
    in-out property <length> text-size: 12px;
    callback clicked();

    background: bg;
    border-radius: radius;
    clip: true;

    TouchArea {
        clicked => { root.clicked(); }
    }

    VerticalBox {
        height: parent.height;
        spacing: 10px;

        Rectangle { vertical-stretch: 1; }

        HorizontalBox {
            Rectangle { horizontal-stretch: 1; }
            Image {
                source: root.icon;
                width: root.icon-size;
                height: root.icon-size;
                horizontal-alignment: center;
                vertical-alignment: center;
                image-fit: contain;
            }
            Rectangle { horizontal-stretch: 1; }
        }

        Text {
            text: root.text;
            color: root.fg;
            horizontal-stretch: 1;
            horizontal-alignment: center;
            vertical-alignment: center;
            font-weight: 600;
            font-family: "Inter";
            font-size: root.text-size;
            wrap: no-wrap;
            overflow: elide;
        }

        Rectangle { vertical-stretch: 1; }
    }
}

component IconButton inherits Rectangle {
    in-out property <string> text: "";
    in property <image> icon;
    in-out property <brush> bg: AppPalette.blue;
    in-out property <brush> fg: #000000;
    in-out property <length> radius: 28px;
    in-out property <length> icon-size: 20px;
    callback clicked();

    background: bg;
    border-radius: radius;
    clip: true;
    height: 44px;
    min-width: 80px;
    vertical-stretch: 0;

    TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalBox {
        height: parent.height;
        spacing: 8px;
        alignment: center;

        Image {
            source: root.icon;
            width: root.icon-size;
            height: root.icon-size;
            horizontal-alignment: center;
            vertical-alignment: center;
            image-fit: contain;
        }

        Text {
            text: root.text;
            color: root.fg;
            vertical-alignment: center;
            wrap: no-wrap;
            overflow: elide;
            font-weight: 600;
            font-family: "Inter";
            font-size: 14px;
        }
    }
}

export component MainWindow inherits Window {
    title: "PQrypt";
    preferred-width: 800px;
    preferred-height: 600px;
    min-width: 520px;
    min-height: 520px;
    background: Palette.background;
    
    // State variables
    in-out property <string> current-page: "welcome";
    in-out property <bool> sender: false;
    in-out property <string> status-text: "";
    in-out property <string> pqc-action-text: "";
    in-out property <string> file-path: "";
    in-out property <string> key-file-path: "";
    in-out property <string> output-file-path: "";
    in-out property <string> password: "";
    in-out property <string> app-name: "";
    in-out property <string> app-password: "";
    in-out property <string> master-password: "";
    in-out property <float> password-length: 20;
    in-out property <bool> set1-enabled: true;
    in-out property <bool> set2-enabled: false;
    in-out property <bool> set3-enabled: false;
    in-out property <string> generated-key-path: "";
    in-out property <string> generated-password: "";
    
    // Secure Share properties
    in-out property <string> secure-share-mode: "file"; // "file" or "text"
    in-out property <string> secure-share-text: "";
    in-out property <string> secure-share-status: "";
    in-out property <string> received-text: "";
    in-out property <string> secure-share-action-text: "";
    
    // Callbacks for backend functions
    callback exit-app();
    callback choose-file();
    callback select-key-file();
    callback encrypt-file();
    callback decrypt-file();
    callback open-key-file();
    callback generate-key-file();
    callback reset-pqc();
    callback generate-password();
    callback copy-password();
    callback erase-password();
    
    // Secure Share callbacks
    callback secure-share-choose-file();
    callback secure-share-start-sender();
    callback secure-share-start-receiver();
    callback secure-share-generate-key();
    callback secure-share-open-key();
    callback secure-share-action();
    callback secure-share-reset();
    callback secure-share-encrypt();
    callback secure-share-decrypt();
    callback secure-share-choose-key-folder();
    
    VerticalBox {
        // Welcome Page
        if current-page == "welcome": ScrollView {
            VerticalBox {
                spacing: 20px;
                padding: 20px;
            
            // Top bar: Exit (left) and Help? (right)
            HorizontalBox {
                ColorButton {
                    text: "Exit";
                    bg: AppPalette.light_purple;
                    clicked => { exit-app(); }
                }
                Rectangle { }
            }
            
            Text {
                text: "Welcome to PQrypt";
                font-size: 24px;
                font-weight: 700;
                font-family: "Inter";
                horizontal-alignment: center;
            }

            HorizontalBox {
                Rectangle { }
                Image {
                    source: @image-url("SVG/Logo.svg");
                    width: 72px;
                    height: 72px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    image-fit: contain;
                }
                Rectangle { }
            }

                HorizontalBox {
                    Rectangle { horizontal-stretch: 1; }

                    VerticalBox {
                        spacing: 12px;
                        alignment: center;

                        property <length> grid_w: Math.min(root.width - 40px, 420px);
                        property <length> tile: Math.min(170px, (grid_w - 12px) / 2);
                        property <length> row_w: tile * 2 + 12px;
                        width: grid_w;

                        HorizontalBox {
                            Rectangle { horizontal-stretch: 1; }
                            HorizontalBox {
                                spacing: 12px;
                                width: row_w;

                                TileButton {
                                    text: "Secure Share";
                                    bg: AppPalette.light_purple;
                                    radius: 28px;
                                    icon: @image-url("SVG/Secure_share.svg");
                                    width: tile;
                                    height: tile;
                                    clicked => {
                                        // Reset all state when navigating
                                        file-path = ""; key-file-path = ""; output-file-path = "";
                                        password = ""; status-text = ""; generated-key-path = ""; generated-password = "";
                                        app-name = ""; app-password = ""; master-password = "";
                                        secure-share-text = ""; secure-share-status = ""; received-text = "";
                                        current-page = "secure-share";
                                    }
                                }

                                TileButton {
                                    text: "File Encryption";
                                    bg: AppPalette.red;
                                    radius: 28px;
                                    icon: @image-url("SVG/file_encryption.svg");
                                    width: tile;
                                    height: tile;
                                    clicked => {
                                        // Reset all state when navigating
                                        file-path = ""; key-file-path = ""; output-file-path = "";
                                        password = ""; status-text = ""; generated-key-path = ""; generated-password = "";
                                        app-name = ""; app-password = ""; master-password = "";
                                        current-page = "file-encryption";
                                    }
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }

                        HorizontalBox {
                            Rectangle { horizontal-stretch: 1; }
                            HorizontalBox {
                                spacing: 12px;
                                width: row_w;

                                TileButton {
                                    text: "PQC Key Exchange";
                                    bg: AppPalette.green;
                                    radius: 28px;
                                    icon: @image-url("SVG/PQC_key_exchange.svg");
                                    width: tile;
                                    height: tile;
                                    clicked => {
                                        // Reset all state when navigating
                                        file-path = ""; key-file-path = ""; output-file-path = "";
                                        password = ""; status-text = ""; generated-key-path = ""; generated-password = "";
                                        app-name = ""; app-password = ""; master-password = "";
                                        current-page = "pqc-key-exchange";
                                    }
                                }

                                TileButton {
                                    text: "Password Generator";
                                    bg: AppPalette.blue;
                                    radius: 28px;
                                    icon: @image-url("SVG/Password_generator.svg");
                                    width: tile;
                                    height: tile;
                                    clicked => {
