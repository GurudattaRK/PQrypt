                        bg: AppPalette.light_orange;
                        width: 520px;
                        height: 44px;
                        icon-size: 18px;
                        clicked => { current-page = "help-welcome"; }
                    }
                    Rectangle { }
                }
            }
        }
        
        // File Encryption Page
        if current-page == "file-encryption": ScrollView {
            VerticalBox {
                spacing: 15px;
                padding: 20px;
            
            HorizontalBox {
