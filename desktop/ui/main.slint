                    }

                    VerticalBox {
                        spacing: 12px;
                        alignment: center;

                        property <length> grid_w: 360px;
                        property <length> tile: Math.min(180px, (grid_w - 12px) / 2);

                        HorizontalBox {
                            Rectangle { horizontal-stretch: 1; }
                            HorizontalBox {
                                spacing: 12px;
                                width: grid_w;
                                alignment: center;

                                TileButton {
                                    text: "Sender";
                                    icon: @image-url("SVG/send.svg");
                                    bg: AppPalette.blue;
                                    radius: 28px;
                                    icon-size: 56px;
                                    text-size: 12px;
                                    width: tile;
                                    height: tile;
                                    clicked => {
                                        sender = true;
                                        current-page = "pqc-exchange-main";
                                        // Reset outputs
                                        key-file-path = ""; generated-key-path = "";
                                        status-text = "Step 1: Tap 'Start' to create 1.key";
                                        pqc-action-text = "Start";
                                        reset-pqc();
                                    }
                                }

                                TileButton {
                                    text: "Receiver";
                                    icon: @image-url("SVG/receive.svg");
                                    bg: AppPalette.blue;
                                    radius: 28px;
                                    icon-size: 56px;
                                    text-size: 12px;
                                    width: tile;
                                    height: tile;
                                    clicked => {
                                        sender = false;
                                        current-page = "pqc-exchange-main";
                                        // Reset outputs
                                        key-file-path = ""; generated-key-path = "";
                                        status-text = "Step 1: Tap 'Open 1.key' from sender to generate 2.key";
                                        pqc-action-text = "Open 1.key";
                                        reset-pqc();
                                    }
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                }

                Rectangle { }
            }

                Rectangle { }
